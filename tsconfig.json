{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"], "@shared/*": ["supabase/functions/_shared/*"] },
    "types": ["vite/client"]
  },
  "include": ["src", "supabase/functions/_shared", "scripts"],
  "exclude": ["supabase/functions/_shared/anthropic.ts", "supabase/functions/_shared/gmail.ts", "supabase/functions/_shared/deno.ts"]
}
